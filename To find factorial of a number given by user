import java.util.Scanner;
class Main {
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int n;
      int i;
      long fact=1;
      System .out.println("Enter the number");
      n=sc.nextInt();
      
      if(n==0 && n==1)
      {
          System.out.println(1);
      }
      for(i=1; i<=n; i++)
      {
          fact*=i;
      }
      System.out.println("factorial of the number is "+fact);
      
    }
}
